---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// Manual order, matching what the Post Types Order plugin gave the old site.
const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout title="Work" description="Selected copywriting and brand voice work by Ash Broadway.">
	<div id="primary" class="content-area">
		<main id="main" class="site-main">
			<div class="container work-items">
				{
					caseStudies.map((study) => (
						<div class="work-item">
							{study.data.logo && (
								<div class="work-thumbnail">
									<a href={`/portfolio/${study.id}/`}>
										<img
											src={study.data.logo}
											alt={study.data.logoAlt ?? ""}
										/>
									</a>
								</div>
							)}
							<h3 class="h3">
								<a href={`/portfolio/${study.id}/`}>{study.data.title}</a>
							</h3>
						</div>
					))
				}
			</div>
		</main>
	</div>
</Layout>
