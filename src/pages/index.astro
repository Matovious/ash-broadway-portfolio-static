---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const about = await getEntry("pages", "about");
if (!about) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(about);
---

<Layout>
	<div id="primary" class="content-area">
		<main id="main" class="site-main container">
			<article class="entry-content">
				{
					about.data.heroImage && (
						<figure class="content-figure caption-top no-padding">
							<img
								src={about.data.heroImage}
								alt={about.data.heroCaption || about.data.title}
								width="2000"
								height="1050"
							/>
							{about.data.heroCaption && (
								<figcaption><em>{about.data.heroCaption}</em></figcaption>
							)}
						</figure>
					)
				}
				<Content />
			</article>
		</main>
	</div>
</Layout>
