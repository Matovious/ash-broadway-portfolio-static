# GitHub OAuth app credentials, used only to sign editors into the CMS.
# Create the app at: GitHub -> Settings -> Developer settings -> OAuth Apps
#   Homepage URL:              https://ashbroadway.com
#   Authorization callback URL: https://ashbroadway.com/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hostnames allowed to receive an OAuth token from the sign-in popup.
ALLOWED_DOMAINS=ashbroadway.com
